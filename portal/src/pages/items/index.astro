---
import Base from '../../layouts/Base.astro';
import ItemCard from '../../components/ItemCard.astro';
import SearchBox from '../../components/SearchBox.astro';
import { getItems } from '../../lib/data';

const items = getItems();
const byRarity = {
  common: items.filter((i) => i.rarity === 'common'),
  uncommon: items.filter((i) => i.rarity === 'uncommon'),
  rare: items.filter((i) => i.rarity === 'rare'),
  'very-rare': items.filter((i) => i.rarity === 'very-rare'),
};

const rarityLabels: Record<string, string> = {
  common: 'Común',
  uncommon: 'Poco común',
  rare: 'Raro',
  'very-rare': 'Muy raro',
};
const order = ['common', 'uncommon', 'rare', 'very-rare'];
const rarityRoman: Record<string, string> = {
  common: 'I',
  uncommon: 'II',
  rare: 'III',
  'very-rare': 'IV',
};
---

<Base title="Items mágicos" description="Items mágicos de TOW traducidos al español. Buscá por nombre o filtrá por rareza.">
  <section class="container-wide py-12">
    <div class="mb-10">
      <p class="section-label mb-3">Lámina II · Items mágicos</p>
      <div class="flex items-end justify-between flex-wrap gap-4">
        <h1 class="font-serif text-4xl md:text-5xl leading-tight">
          {items.length} {items.length === 1 ? 'item mágico' : 'items mágicos'}.
        </h1>
        <SearchBox targetSelector="[data-searchable]" placeholder="Buscar item (espada, armadura, talismán…)" />
      </div>
      <hr class="divider-accent mt-6" />
    </div>

    {items.length === 0 && (
      <div class="lamina" style="border-style: dashed">
        <p class="font-serif text-xl mb-2" style="color: var(--accent)">No hay items cargados todavía.</p>
        <p class="text-sm" style="color: var(--muted)">
          Corré <code class="font-mono">npm run rules:sync</code> desde la raíz del monorepo.
        </p>
      </div>
    )}

    {order.map((rarity) => {
      const list = byRarity[rarity as keyof typeof byRarity];
      if (!list || list.length === 0) return null;
      return (
        <div class="mb-12">
          <div class="flex items-baseline gap-3 mb-5">
            <span class="section-label" style="color: var(--accent)">§ {rarityRoman[rarity]}</span>
            <h2 class="font-serif text-2xl">{rarityLabels[rarity]}</h2>
            <span class="font-mono text-xs" style="color: var(--muted)">{list.length} items</span>
          </div>
          <hr class="scroll-divider mt-0 mb-5" />
          <div class="grid md:grid-cols-2 gap-4">
            {list.map((i) => (
              <ItemCard
                slug={i.id.replace(/^item-/, '')}
                name={i.name}
                nameEs={i.nameEs}
                rarity={i.rarity}
                points={i.points}
                descriptionEs={i.descriptionEs}
              />
            ))}
          </div>
        </div>
      );
    })}
  </section>
</Base>
