---
import Base from '../../layouts/Base.astro';
import { getRules } from '../../lib/data';

export function getStaticPaths() {
  return getRules().map((r) => ({
    params: { slug: r.id.replace(/^rule-/, '') },
  }));
}

const { slug } = Astro.params;
const rule = getRules().find((r) => r.id === `rule-${slug}` || r.id === slug);

if (!rule) {
  return Astro.redirect('/reglas');
}

const categoryLabels: Record<string, string> = {
  combat: 'Combate',
  shooting: 'Disparo',
  magic: 'Magia',
  movement: 'Movimiento',
  leadership: 'Mando',
  equipment: 'Equipo',
  armour: 'Armadura',
  psychology: 'Psicología',
};
const catLabel = categoryLabels[rule.category] ?? rule.category;
---

<Base title={rule.nameEs} description={`Regla "${rule.nameEs}" de TOW — ${rule.descriptionEs.slice(0, 120)}…`} skin="codex">
  <article class="container-narrow py-12">
    <a href="/reglas" class="no-print text-sm hover:underline" style="color: var(--muted)">← Todas las reglas</a>

    <header class="mt-4 mb-8">
      <div class="flex items-center gap-2 mb-3 flex-wrap">
        <span class="tag tag-accent">{catLabel}</span>
        <span class="section-label">§ Regla</span>
      </div>
      <h1 class="font-serif text-4xl md:text-5xl leading-tight mb-2">{rule.nameEs}</h1>
      {rule.nameEs !== rule.name && (
        <p class="text-sm italic" style="color: var(--muted)">{rule.name}</p>
      )}
      <hr class="divider-accent mt-4" />
    </header>

    <div class="block-l mb-6 print-clean">
      <p class="text-base leading-relaxed dropcap" style="color: var(--fg)">{rule.descriptionEs}</p>
    </div>

    <details class="no-print mb-8">
      <summary class="cursor-pointer text-sm hover:underline" style="color: var(--muted)">Ver texto original (inglés)</summary>
      <p class="mt-3 text-sm leading-relaxed italic border-l-2 pl-4" style="color: var(--muted); border-color: var(--line)">
        {rule.description}
      </p>
    </details>

    <footer class="text-xs flex flex-wrap items-center justify-between gap-3 pt-4 no-print" style="color: var(--muted)">
      <p>
        <span class="section-label">Fuente</span> ·
        <a href={rule.source.page} rel="noopener" class="font-mono ml-1">{rule.source.page}</a>
        · Verificado: {rule.source.lastVerified}
      </p>
      <button class="cta-ghost text-xs" onclick="window.print()">Imprimir regla</button>
    </footer>

    <!-- Print-only header -->
    <div class="print-only mb-4 pb-2" style="border-bottom: 2px solid black">
      <p class="font-serif text-2xl">Dobleuno · {rule.nameEs}</p>
      <p class="text-xs">Fuente: {rule.source.page} · Verificado: {rule.source.lastVerified}</p>
    </div>
  </article>
</Base>
