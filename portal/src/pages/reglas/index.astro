---
import Base from '../../layouts/Base.astro';
import RuleCard from '../../components/RuleCard.astro';
import SearchBox from '../../components/SearchBox.astro';
import { getRules, groupRulesByCategory } from '../../lib/data';

const rules = getRules();
const groups = groupRulesByCategory(rules);

const categoryLabels: Record<string, string> = {
  combat: 'Combate',
  shooting: 'Disparo',
  magic: 'Magia',
  movement: 'Movimiento',
  leadership: 'Mando',
  equipment: 'Equipo',
  armour: 'Armadura',
  psychology: 'Psicología',
};

const orderedCategories = Object.keys(categoryLabels);
const totalRules = rules.length;
---

<Base title="Reglas especiales" description="Reglas especiales de TOW traducidas al español. Buscá, navegá por fase, imprimí." skin="codex">
  <!-- Hero Codex: pergamino iluminado de fondo -->
  <section class="hero-codex relative overflow-hidden">
    <div class="hero-overlay-codex absolute inset-0"></div>
    <div class="container-wide relative z-10 pt-12 md:pt-16 pb-10">
      <p class="section-label mb-3">§ Reglas especiales · Codex</p>
      <div class="flex items-end justify-between flex-wrap gap-4">
        <h1 class="font-serif text-4xl md:text-5xl leading-tight">
          {totalRules} {totalRules === 1 ? 'regla' : 'reglas'} en español.
        </h1>
        <SearchBox targetSelector="[data-searchable]" placeholder="Buscar regla (carga, cover, frenzy…)" />
      </div>
      <hr class="divider-accent mt-6" />
    </div>
  </section>

  <!-- Contenido -->
  <section class="container-wide py-12">
    {rules.length === 0 && (
      <div class="block-l">
        <p class="font-serif text-xl mb-2" style="color: var(--accent)">No hay reglas cargadas todavía.</p>
        <p class="text-sm" style="color: var(--muted)">
          Corré <code class="font-mono">npm run rules:sync</code> desde la raíz del monorepo para descargar y traducir las reglas.
        </p>
      </div>
    )}

    {orderedCategories.map((cat, idx) => {
      const items = groups[cat];
      if (!items || items.length === 0) return null;
      const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'][idx] ?? String(idx + 1);
      return (
        <div class="mb-12">
          <div class="flex items-baseline gap-3 mb-5">
            <span class="section-label" style="color: var(--accent)">§ {roman}</span>
            <h2 class="font-serif text-2xl">{categoryLabels[cat]}</h2>
            <span class="font-mono text-xs" style="color: var(--muted)">{items.length}</span>
          </div>
          <hr class="scroll-divider mt-0 mb-5" />
          <div class="grid md:grid-cols-2 gap-x-8 gap-y-4">
            {items.map((r) => (
              <RuleCard
                slug={r.id.replace(/^rule-/, '')}
                name={r.name}
                nameEs={r.nameEs}
                descriptionEs={r.descriptionEs}
                category={r.category}
              />
            ))}
          </div>
        </div>
      );
    })}
  </section>
</Base>

<style>
  /* Hero Codex: folio manuscrito iluminado de fondo, con overlay oscuro para legibilidad */
  .hero-codex {
    background-image: url('/brand/hero-codex.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .hero-overlay-codex {
    background: linear-gradient(
      to bottom,
      rgba(16, 12, 8, 0.7) 0%,
      rgba(16, 12, 8, 0.5) 60%,
      rgba(16, 12, 8, 0.85) 100%
    );
  }
  :root[data-skin="codex"][data-mode="light"] .hero-overlay-codex {
    background: linear-gradient(
      to bottom,
      rgba(244, 237, 224, 0.5) 0%,
      rgba(244, 237, 224, 0.3) 60%,
      rgba(244, 237, 224, 0.7) 100%
    );
  }
</style>