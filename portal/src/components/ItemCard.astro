---
/**
 * ItemCard — estilo Cartógrafo: marco de lámina + ◯ delante del nombre.
 * Marco fino, hover engrosa el borde al accent.
 */
interface Props {
  slug: string;
  name: string;
  nameEs: string;
  rarity: string;
  points: number;
  descriptionEs: string;
}
const { slug, name, nameEs, rarity, points, descriptionEs } = Astro.props;
const rarityLabels: Record<string, string> = {
  common: 'Común',
  uncommon: 'Poco común',
  rare: 'Raro',
  'very-rare': 'Muy raro',
};
const rarityClasses: Record<string, string> = {
  common: 'tag',
  uncommon: 'tag',
  rare: 'tag tag-accent',
  'very-rare': 'tag tag-ink',
};
const preview = descriptionEs.length > 180 ? descriptionEs.slice(0, 180) + '…' : descriptionEs;
---

<a href={`/items/${slug}`} class="lamina block" data-searchable>
  <div class="flex items-start justify-between gap-3 mb-2">
    <div class="flex items-baseline gap-2 min-w-0">
      <span class="section-label" style="color: var(--accent)">◯</span>
      <h3 class="font-serif text-lg leading-snug">
        {nameEs !== name ? `${nameEs} (${name})` : nameEs}
      </h3>
    </div>
    <div class="flex flex-col items-end gap-1 shrink-0">
      <span class={rarityClasses[rarity] ?? 'tag'}>{rarityLabels[rarity] ?? rarity}</span>
      <span class="font-mono text-xs" style="color: var(--accent)">{points} pts</span>
    </div>
  </div>
  <p class="text-sm leading-relaxed" style="color: var(--muted)">{preview}</p>
</a>
