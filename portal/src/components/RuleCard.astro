---
/**
 * RuleCard — estilo Codex: bloque con borde lateral accent + § delante del nombre.
 * Sin card redondeada, sin sombra. Hover sutil.
 */
interface Props {
  slug: string;
  name: string;
  nameEs: string;
  descriptionEs: string;
  category: string;
}
const { slug, name, nameEs, descriptionEs } = Astro.props;
const preview = descriptionEs.length > 200 ? descriptionEs.slice(0, 200) + '…' : descriptionEs;
---

<a href={`/reglas/${slug}`} class="block-l block" data-searchable>
  <div class="flex items-baseline gap-2 mb-1">
    <span class="section-label" style="color: var(--accent)">§</span>
    <h3 class="font-serif text-lg leading-snug">
      {nameEs !== name ? `${nameEs} (${name})` : nameEs}
    </h3>
  </div>
  <p class="text-sm leading-relaxed" style="color: var(--muted)">{preview}</p>
</a>
