---
/**
 * Sigilo "2·1" en heater shield.
 *
 * - size="mini" (default): SVG inline compacto, ideal para header.
 *   - brandSrc?: si se pasa, usa PNG del brand kit en lugar del SVG.
 * - size="full": PNG del iluminado (02-illuminated) generado por matrix,
 *   pensado para hero del portal.
 */
interface Props {
  size?: 'mini' | 'full';
  class?: string;
  brandSrc?: string;
}
const { size = 'mini', class: className = '', brandSrc } = Astro.props;

// Tamaños del SVG mini (header)
const dims = { w: 32, h: 38, fontBig: 44 };

// Tamaños del iluminado (hero)
const fullDims = { w: 480, h: 540 };

// Si brandSrc viene, renderizar PNG. Si no y size=full, usar el iluminado por default.
const src = brandSrc ?? (size === 'full' ? '/brand/02-illuminated.png' : null);
---

{src ? (
  <img
    src={src}
    alt="Dobleuno"
    class={`sigil-mark ${className}`}
    width={size === 'full' ? fullDims.w : dims.w}
    height={size === 'full' ? fullDims.h : dims.h}
    loading="lazy"
    decoding="async"
  />
) : (
  <svg class={`sigil-mark ${className}`} width={dims.w} height={dims.h} viewBox="0 0 100 120" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <linearGradient id={`g-${size}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#c41e3a" />
        <stop offset="1" stop-color="#7e1313" />
      </linearGradient>
      <linearGradient id={`br-${size}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e0c283" />
        <stop offset="1" stop-color="#7d5a07" />
      </linearGradient>
    </defs>
    <path d="M50 4 L96 4 L96 60 Q96 96 50 116 Q4 96 4 60 L4 4 Z" fill={`url(#g-${size})`} stroke={`url(#br-${size})`} stroke-width="3" />
    <text x="50" y="68" text-anchor="middle" font-family="DM Serif Display, serif" font-size={dims.fontBig} fill="#f7f5f0" font-weight="bold">2·1</text>
  </svg>
)}