---
import Sigil from '../components/Sigil.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Piel: 'cartografo' (default) o 'codex'. Se aplica al <html>. */
  skin?: 'cartografo' | 'codex';
}
const {
  title,
  description = 'Dobleuno — el compañero de mesa para Warhammer: The Old World. Reglamento traducido y navegable.',
  skin = 'cartografo',
} = Astro.props;
const path = Astro.url.pathname;
const isActive = (prefix: string): boolean => path === prefix || path.startsWith(prefix + '/');
---

<!doctype html>
<html lang="es-AR" data-skin={skin} data-mode="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Dobleuno</title>
    <meta name="description" content={description} />

    <!-- Pre-paint: aplicar data-mode desde localStorage / prefers-color-scheme
         ANTES de que el body renderice. Sin esto, hay flash de tema equivocado. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('dobleuno-mode');
          var mode = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.dataset.mode = mode;
        } catch (e) { /* localStorage no disponible, default dark */ }
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Outfit:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-[100dvh] flex flex-col">
    <!-- Top nav -->
    <header class="no-print border-b" style="border-color: var(--line)">
      <div class="container-wide py-5 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-3 sigil-link" aria-label="Inicio Dobleuno">
          <Sigil size="mini" />
          <span class="font-serif text-2xl tracking-tight">Dobleuno</span>
        </a>
        <nav class="hidden md:flex items-center gap-7">
          <a href="/reglas" class:list={["nav-link", isActive('/reglas') && 'is-active']}>Reglas</a>
          <a href="/items" class:list={["nav-link", isActive('/items') && 'is-active']}>Items</a>
          <a href="/sobre" class:list={["nav-link", isActive('/sobre') && 'is-active']}>Sobre</a>
        </nav>
        <div class="flex items-center gap-3">
          <button
            id="mode-toggle"
            class="mode-toggle"
            type="button"
            aria-label="Cambiar modo claro/oscuro"
            title="Cambiar modo"
          >
            <span data-mode-icon>☾</span>
          </button>
          <a
            href="https://github.com/JuanoLemos/Dobleuno"
            class="cta-ghost text-xs hidden md:inline-block"
            rel="noopener"
          >
            App
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

    <script>
      const btn = document.getElementById('mode-toggle');
      const icon = btn?.querySelector<HTMLElement>('[data-mode-icon]');
      const ICONS: Record<string, string> = { dark: '\u263E', light: '\u2600' };
      function updateIcon(): void {
        if (!icon) return;
        const mode = document.documentElement.dataset.mode ?? 'dark';
        icon.textContent = ICONS[mode] ?? ICONS.dark;
      }
      btn?.addEventListener('click', () => {
        const current = document.documentElement.dataset.mode ?? 'dark';
        const next = current === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.mode = next;
        try { localStorage.setItem('dobleuno-mode', next); } catch (e) { /* sin storage */ }
        updateIcon();
      });
      updateIcon();
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
