# Dobleuno — configuración de producción
#
#   cp .env.production.example .env
#
# Compose lee este archivo de la raíz automáticamente. Las variables marcadas
# OBLIGATORIA abortan el `docker compose up` si faltan, y el schema del server
# (apps/server/src/env.ts) las vuelve a exigir al arrancar. Es a propósito: con
# defaults permisivos, el server arrancaba en producción con el secreto de
# ejemplo y sin avisar nada.

# ─── Base de datos ────────────────────────────────────────────────────────

POSTGRES_USER=dobleuno
POSTGRES_DB=dobleuno

# OBLIGATORIA. Generala: openssl rand -base64 24
POSTGRES_PASSWORD=

# ─── Auth ─────────────────────────────────────────────────────────────────

# OBLIGATORIA. Generala: openssl rand -base64 32
#
# Dejala vacía hasta tener el valor real. No pongas un placeholder: el default
# que traía el compose ("change-me-in-production-min-32-chars") tiene 35
# caracteres, así que pasaba la validación de longitud y el server arrancaba
# con él. Por eso ahora hay además una lista negra explícita.
BETTER_AUTH_SECRET=

# OBLIGATORIA. El origen público, con esquema. Sin barra final.
# Ej: https://dobleuno.tuclub.ar
BETTER_AUTH_URL=

# ─── CORS ─────────────────────────────────────────────────────────────────

# Dejala VACÍA en la topología de un solo contenedor: la API y el cliente
# comparten origen, así que no hay CORS que habilitar. Sólo completala si vas a
# servir el cliente desde otro dominio.
CORS_ORIGIN=

# ─── LLM ──────────────────────────────────────────────────────────────────

# OBLIGATORIA. Sin ella el oráculo devolvía un mock con citas inventadas y
# HTTP 200, indistinguible de una respuesta real.
DEEPSEEK_API_KEY=

# Los modelos que ofrece la cuenta cambian. Verificá con: npm run deepseek:doctor
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ─── Embeddings: NO setees OPENAI_API_KEY ─────────────────────────────────
#
# El provider de OpenAI devuelve 1536 dimensiones y la columna `embedding_vec`
# es vector(384). Con la key puesta, el seed genera vectores que el trigger de
# pgvector no puede castear: el error se degrada a WARNING, las 3700 filas
# quedan con embedding_vec NULL, el retrieval matchea cero y el oráculo deja de
# funcionar — con el seed saliendo 0 y el health en 200.
#
# El corpus se siembra con el provider determinístico de 384 dims. Migrar a
# 1536 pide ALTER TABLE, re-embeddear todo y recrear el índice: es otra ola.
#
# OPENAI_API_KEY=

# ─── Operación ────────────────────────────────────────────────────────────

LOG_LEVEL=info

# Emails de administradores, separados por coma. Quien tenga uno de estos puede
# disparar el re-sync de la KB desde /api/admin/kb/*.
ADMIN_EMAILS=

# Puerto que publica el host. Detrás de un reverse proxy conviene 127.0.0.1.
PORT_PUBLICO=3000
